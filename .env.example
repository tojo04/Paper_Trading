# Runtime
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# Local PostgreSQL (development values only; replace outside local development)
POSTGRES_DB=paper_terminal
POSTGRES_USER=paper_terminal
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://paper_terminal:change-me@localhost:5432/paper_terminal

# Market data is fake until the Upstox adapter phase.
MARKET_DATA_PROVIDER=fake
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=

